# Copy file này thành .env rồi điền key thật. KHÔNG commit .env.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Tên model theo kiểu LiteLLM/CrewAI (có tiền tố openrouter/)
MODEL=openrouter/qwen/qwen3-14b
# Cổng backend (API + MCP HTTP)
PORT=8787
# Cố định provider để benchmark nhất quán
PROVIDER=DeepInfra
